# ─────────────────────────────────────────────────────────────
#  A to Z Fitness OS — environment template
#  Copy to .env and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# ── Database (Supabase Postgres) ─────────────────────────────
# Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL  = "Transaction pooler"  (port 6543) — used by the running app.
#                 MUST end with ?pgbouncer=true&connection_limit=1
# DIRECT_URL    = "Direct connection"   (port 5432) — used by prisma migrate.
#
# Prisma needs BOTH: the pooler cannot run migrations (no prepared statements),
# and the direct connection is not safe for serverless-style app pooling.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── Gym identity (printed on invoices/receipts) ──────────────
GYM_NAME="A to Z Fitness"
GYM_ADDRESS_LINE1="Mehdipatnam"
GYM_ADDRESS_LINE2="Hyderabad, Telangana 500028"
GYM_PHONE="+91 00000 00000"
GYM_EMAIL="info@atozfitness.in"
GYM_STATE_CODE=36

# ── Tax ──────────────────────────────────────────────────────
# A to Z Fitness is NOT GST registered (below the 20L threshold).
# Documents are issued as plain receipts with no tax component.
# When you cross the threshold: set GST_REGISTERED=true, add GSTIN,
# and set GST_RATE=18. No code changes needed.
GST_REGISTERED=false
GSTIN=
GST_RATE=18
GST_SAC_CODE=999723
PRICES_INCLUDE_TAX=false

# ── SMS (provider-agnostic) ──────────────────────────────────
# SMS_PROVIDER: mock | msg91 | twilio | fast2sms
# 'mock' writes to the DB + UI and sends NOTHING to real phones.
SMS_PROVIDER=mock
SMS_ENABLED=true
SMS_SENDER_ID=AZFITS
SMS_MAX_RETRIES=3
SMS_RETRY_BACKOFF_MS=60000

# MSG91 (fill when ready — DLT-approved template IDs required in India)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_WELCOME=
MSG91_TEMPLATE_EXPIRY=
MSG91_TEMPLATE_DUES=
MSG91_TEMPLATE_BIRTHDAY=
MSG91_TEMPLATE_WINBACK=
DLT_ENTITY_ID=

# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS (alternative)
FAST2SMS_API_KEY=

# ── Email ────────────────────────────────────────────────────
# EMAIL_PROVIDER: mock | smtp | brevo | resend
#
# 'mock' writes each email to ./tmp/email-preview as an .html file you can
# open in a browser. Nothing is actually sent. This is the default.
#
# 'smtp' sends for real. For Gmail:
#   1. Turn on 2-Step Verification at myaccount.google.com
#   2. Security -> App passwords -> generate one for "Mail"
#   3. Put the 16-character password in SMTP_PASSWORD below
#      (your normal Gmail password will NOT work — Google blocks it)
#   Gmail's free limit is roughly 500 emails/day.
#
# Unlike SMS, email needs no DLT registration and costs nothing.
EMAIL_PROVIDER=mock
EMAIL_ENABLED=true
EMAIL_FROM_NAME=A to Z Fitness
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_MS=60000

# SMTP (Gmail defaults shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Not yet implemented — these fall back to mock with a warning.
BREVO_API_KEY=
RESEND_API_KEY=

# ── WhatsApp ─────────────────────────────────────────────────
# WHATSAPP_PROVIDER: mock | meta
#
# 'mock' logs the message and sends nothing. This is the default, and it
# stays the default until Meta business verification completes.
#
# To go live with 'meta':
#   1. Verify the business in Meta Business Manager.
#   2. Add a WhatsApp Business phone number. It must NOT already be
#      registered on the consumer WhatsApp app — this is the step that most
#      often blocks a gym, because the number they already use for members
#      cannot be reused without deleting that WhatsApp account first.
#   3. Submit each template (azf_welcome, azf_payment_receipt,
#      azf_expiry_reminder, azf_payment_due) under category UTILITY.
#      Utility templates are cheaper than marketing ones and are not subject
#      to the per-user frequency cap — which matters for receipts.
#   4. WhatsApp Manager -> API Setup gives the phone number ID and token.
#
# Roughly Rs. 0.30 per message.
WHATSAPP_PROVIDER=mock
WHATSAPP_ENABLED=true
WHATSAPP_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BACKOFF_MS=60000

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Payments (Razorpay) ──────────────────────────────────────
# PAYMENT_PROVIDER: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
